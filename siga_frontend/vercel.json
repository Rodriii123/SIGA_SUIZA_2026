{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://sigasuiza2026-production-304889ea.up.railway.app/health"
    },
    {
      "source": "/api/mod-gestion-academica/estudiantes/",
      "destination": "https://sigasuiza2026-production-304889ea.up.railway.app/api/mod-gestion-academica/estudiantes/"
